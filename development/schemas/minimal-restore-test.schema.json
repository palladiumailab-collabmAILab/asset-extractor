{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/asset-extractor/minimal-restore-test.schema.json",
  "title": "Python-only minimal archive restore test manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "created_at",
    "status",
    "tool",
    "policy",
    "output_directory",
    "limits",
    "sources",
    "selection",
    "assets",
    "source_unchanged",
    "failures",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"const": "minimal-archive-restore-test"},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "failed"]},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "python"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_only", "external_commands", "payload_execution", "source_read_only"],
      "properties": {
        "python_only": {"const": true},
        "external_commands": {"const": false},
        "payload_execution": {"const": false},
        "source_read_only": {"const": true}
      }
    },
    "output_directory": {"type": "string", "minLength": 1},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_member_bytes", "max_total_bytes", "max_ratio"],
      "properties": {
        "max_member_bytes": {"type": "integer", "exclusiveMinimum": 0},
        "max_total_bytes": {"type": "integer", "exclusiveMinimum": 0},
        "max_ratio": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index", "path", "name", "bytes", "sha256_before", "sha256_after",
          "source_unchanged", "expected_sha256", "expected_match", "archive_entries",
          "status", "error"
        ],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "path": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "bytes": {"type": ["integer", "null"], "minimum": 0},
          "sha256_before": {"$ref": "#/$defs/nullableSha256"},
          "sha256_after": {"$ref": "#/$defs/nullableSha256"},
          "source_unchanged": {"type": ["boolean", "null"]},
          "expected_sha256": {"$ref": "#/$defs/nullableSha256"},
          "expected_match": {"type": ["boolean", "null"]},
          "archive_entries": {"type": ["integer", "null"], "minimum": 0},
          "status": {"enum": ["pending", "missing", "error", "ready"]},
          "error": {"type": ["string", "null"]}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "image", "candidate_rejections"],
      "properties": {
        "video": {"$ref": "#/$defs/selectionEntry"},
        "image": {"$ref": "#/$defs/selectionEntry"},
        "candidate_rejections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["video", "image"],
          "properties": {
            "video": {"type": "array", "items": {"type": "string"}},
            "image": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "source_unchanged": {"type": ["boolean", "null"]},
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "stage", "error"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "minLength": 1},
          "error": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets_requested", "assets_completed", "hashes_verified", "formats_verified"],
      "properties": {
        "assets_requested": {"const": 2},
        "assets_completed": {"type": "integer", "minimum": 0},
        "hashes_verified": {"type": "integer", "minimum": 0},
        "formats_verified": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "nullableSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "family", "mime", "method"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "family": {"enum": ["video", "image", "unknown"]},
        "mime": {"type": "string", "minLength": 1},
        "method": {"enum": ["magic", "unrecognised"]}
      }
    },
    "selectionEntry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source_index", "source_archive", "member", "declared_bytes", "compressed_bytes", "crc32", "detection"],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0},
        "source_archive": {"type": "string", "minLength": 1},
        "member": {"type": "string", "minLength": 1},
        "declared_bytes": {"type": "integer", "minimum": 0},
        "compressed_bytes": {"type": "integer", "minimum": 0},
        "crc32": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}$"},
        "detection": {"$ref": "#/$defs/detection"},
        "nested": {"type": "boolean"},
        "container_member": {"type": "string", "minLength": 1},
        "container_sha256": {"$ref": "#/$defs/sha256"},
        "nested_entry_index": {"type": "integer", "minimum": 0},
        "nested_payload_id": {"type": "integer", "minimum": 0}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "nested", "source_index", "source_archive", "member", "output", "zip_member_bytes",
        "restored_bytes", "zip_crc32", "read_crc32", "source_member_sha256", "restored_sha256",
        "hash_match", "bytes_match", "source_detection", "restored_detection", "format_match", "status"
      ],
      "properties": {
        "kind": {"enum": ["video", "image"]},
        "nested": {"type": "boolean"},
        "source_index": {"type": "integer", "minimum": 0},
        "source_archive": {"type": "string", "minLength": 1},
        "member": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1},
        "zip_member_bytes": {"type": "integer", "minimum": 0},
        "restored_bytes": {"type": "integer", "minimum": 0},
        "zip_crc32": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}$"},
        "read_crc32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
        "source_member_sha256": {"$ref": "#/$defs/sha256"},
        "restored_sha256": {"$ref": "#/$defs/sha256"},
        "hash_match": {"const": true},
        "bytes_match": {"const": true},
        "source_detection": {"$ref": "#/$defs/detection"},
        "restored_detection": {"$ref": "#/$defs/detection"},
        "format_match": {"const": true},
        "status": {"const": "complete"},
        "container_member": {"type": "string", "minLength": 1},
        "container_sha256": {"$ref": "#/$defs/sha256"},
        "container_bytes": {"type": "integer", "minimum": 0},
        "nested_entry_index": {"type": "integer", "minimum": 0},
        "nested_payload_id": {"type": "integer", "minimum": 0},
        "nested_payload_offset": {"type": "integer", "minimum": 0},
        "nested_packed_bytes": {"type": "integer", "minimum": 0},
        "nested_declared_unpacked_bytes": {"type": "integer", "minimum": 0},
        "nested_compression_flag": {"type": "integer", "minimum": 0},
        "nested_encrypted": {"type": "boolean"}
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
